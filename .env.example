# Copy this file to `.env` and fill in YOUR real values. Never commit real credentials.

# Supabase (app database + auth)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# AI (Gemini) — used for AI chat responses
VITE_GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key

# Google Sign-In (used on the Login / Signup "Continue with Google" buttons)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Server-side email (SMTP) — used by server.cjs for sending emails
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
