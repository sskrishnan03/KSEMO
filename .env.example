# Core Application Settings
NODE_ENV=development
PORT=3000
VITE_APP_ID=ksemo-development

# Security
JWT_SECRET=your-secret-key-here-generate-a-secure-random-string
OWNER_OPEN_ID=your-admin-openid-here

# OAuth Configuration
OAUTH_SERVER_URL=https://your-oauth-server.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# AI Configuration
BUILT_IN_FORGE_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
BUILT_IN_FORGE_API_KEY=your-ai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Supabase Configuration (Required for database operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Email Configuration (Optional - Required for password reset functionality)
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Alternative SMTP Configuration (for other email providers)
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@yourdomain.com
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587